---
layout: null
permalink: /site.webmanifest
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "icons": [
    { "src": "{{ '/assets/images/icons/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/images/icons/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#0f5249",
  "background_color": "#fbfbf8",
  "display": "browser"
}
